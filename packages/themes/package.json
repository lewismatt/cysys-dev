{
  "name": "@cysys/themes",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Cynerdyne Systems shadcn themes (tweakcn registry items compiled to data-theme scoped CSS).",
  "scripts": {
    "themes": "node scripts/themes.mjs",
    "build:themes": "node scripts/themes.mjs build",
    "check": "node scripts/themes.mjs check",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*.css": "./css/*.css",
    "./registry/*.json": "./registry/*.json",
    "./themes.json": "./themes.json"
  },
  "files": [
    "css",
    "registry",
    "src",
    "themes.json"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
