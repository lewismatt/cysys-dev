{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "eldora-night",
  "title": "Eldora Night",
  "description": "Eldora Night from the Eldora snowmaking dashboard as a shadcn theme: logo orange #e65400 on clean near-neutral surfaces (dark: near-black; light: off-white), the dashboard's status colors as tokens (softened; all AA), IBM Plex Sans for reading and IBM Plex Mono for headings, labels and figures. Charts: 1 brand, 2 Good, 3 Prime, 4 Marginal, 5 wind.",
  "dependencies": [
    "@fontsource-variable/ibm-plex-sans",
    "@fontsource/ibm-plex-mono"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "'IBM Plex Sans Variable', 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif",
      "font-mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
      "font-serif": "ui-serif, Georgia, Cambria, 'Times New Roman', serif",
      "radius": "0.625rem",
      "tracking-normal": "0em",
      "color-prime": "var(--prime)",
      "color-on-prime": "var(--on-prime)",
      "color-good": "var(--good)",
      "color-on-good": "var(--on-good)",
      "color-marginal": "var(--marginal)",
      "color-on-marginal": "var(--on-marginal)",
      "color-no-window": "var(--no-window)",
      "color-on-no-window": "var(--on-no-window)",
      "color-wind": "var(--wind)",
      "color-stale": "var(--stale)",
      "color-link": "var(--link)",
      "font-heading": "var(--font-mono)"
    },
    "light": {
      "background": "#fafaf9",
      "foreground": "#111110",
      "card": "#ffffff",
      "card-foreground": "#111110",
      "popover": "#ffffff",
      "popover-foreground": "#111110",
      "primary": "#e65400",
      "primary-foreground": "#0a0a09",
      "secondary": "#f2f2f0",
      "secondary-foreground": "#111110",
      "muted": "#f2f2f0",
      "muted-foreground": "#5c5b56",
      "accent": "#efefed",
      "accent-foreground": "#111110",
      "destructive": "#cc1616",
      "destructive-foreground": "#ffffff",
      "border": "#e5e5e2",
      "input": "#d6d6d2",
      "ring": "#e65400",
      "chart-1": "#e65400",
      "chart-2": "#2d6a99",
      "chart-3": "#2e7a4b",
      "chart-4": "#8f5f12",
      "chart-5": "#6a4fa8",
      "sidebar": "#f7f7f6",
      "sidebar-foreground": "#111110",
      "sidebar-primary": "#e65400",
      "sidebar-primary-foreground": "#0a0a09",
      "sidebar-accent": "#efefed",
      "sidebar-accent-foreground": "#111110",
      "sidebar-border": "#e5e5e2",
      "sidebar-ring": "#e65400",
      "shadow-2xs": "0 1px 0 0 rgb(10 10 9 / 0.04)",
      "shadow-xs": "0 1px 2px 0 rgb(10 10 9 / 0.05)",
      "shadow-sm": "0 1px 3px 0 rgb(10 10 9 / 0.08), 0 1px 2px -1px rgb(10 10 9 / 0.08)",
      "shadow": "0 1px 3px 0 rgb(10 10 9 / 0.08), 0 1px 2px -1px rgb(10 10 9 / 0.08)",
      "shadow-md": "0 4px 6px -1px rgb(10 10 9 / 0.08), 0 2px 4px -2px rgb(10 10 9 / 0.08)",
      "shadow-lg": "0 10px 15px -3px rgb(10 10 9 / 0.08), 0 4px 6px -4px rgb(10 10 9 / 0.08)",
      "shadow-xl": "0 20px 25px -5px rgb(10 10 9 / 0.08), 0 8px 10px -6px rgb(10 10 9 / 0.08)",
      "shadow-2xl": "0 25px 50px -12px rgb(10 10 9 / 0.2)",
      "prime": "#2e7a4b",
      "on-prime": "#ffffff",
      "good": "#2d6a99",
      "on-good": "#ffffff",
      "marginal": "#8f5f12",
      "on-marginal": "#ffffff",
      "no-window": "#b03a2e",
      "on-no-window": "#ffffff",
      "wind": "#6a4fa8",
      "stale": "#5c5b56",
      "link": "#bd4500"
    },
    "dark": {
      "background": "#0a0a09",
      "foreground": "#ecebe8",
      "card": "#111110",
      "card-foreground": "#ecebe8",
      "popover": "#161615",
      "popover-foreground": "#ecebe8",
      "primary": "#e65400",
      "primary-foreground": "#0a0a09",
      "secondary": "#1b1b19",
      "secondary-foreground": "#ecebe8",
      "muted": "#1b1b19",
      "muted-foreground": "#9a9993",
      "accent": "#262624",
      "accent-foreground": "#ecebe8",
      "destructive": "#f87171",
      "destructive-foreground": "#0a0a09",
      "border": "#232321",
      "input": "#2e2e2b",
      "ring": "#e65400",
      "chart-1": "#e65400",
      "chart-2": "#6fa9d2",
      "chart-3": "#6cbf8a",
      "chart-4": "#d4a24c",
      "chart-5": "#c3b2dd",
      "sidebar": "#080807",
      "sidebar-foreground": "#ecebe8",
      "sidebar-primary": "#e65400",
      "sidebar-primary-foreground": "#0a0a09",
      "sidebar-accent": "#1b1b19",
      "sidebar-accent-foreground": "#ecebe8",
      "sidebar-border": "#232321",
      "sidebar-ring": "#e65400",
      "shadow-2xs": "0 1px 0 0 rgb(0 0 0 / 0.3)",
      "shadow-xs": "0 1px 2px 0 rgb(0 0 0 / 0.35)",
      "shadow-sm": "0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.4)",
      "shadow": "0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.4)",
      "shadow-md": "0 4px 6px -1px rgb(0 0 0 / 0.45), 0 2px 4px -2px rgb(0 0 0 / 0.45)",
      "shadow-lg": "0 10px 15px -3px rgb(0 0 0 / 0.5), 0 4px 6px -4px rgb(0 0 0 / 0.5)",
      "shadow-xl": "0 20px 25px -5px rgb(0 0 0 / 0.5), 0 8px 10px -6px rgb(0 0 0 / 0.5)",
      "shadow-2xl": "0 25px 50px -12px rgb(0 0 0 / 0.7)",
      "prime": "#6cbf8a",
      "on-prime": "#0a0a09",
      "good": "#6fa9d2",
      "on-good": "#0a0a09",
      "marginal": "#d4a24c",
      "on-marginal": "#0a0a09",
      "no-window": "#db7b6c",
      "on-no-window": "#0a0a09",
      "wind": "#c3b2dd",
      "stale": "#c9c7c0",
      "link": "#e65400"
    }
  },
  "css": {
    "@layer base": {
      "html": {
        "scrollbar-color": "var(--input) transparent"
      },
      "body": {
        "letter-spacing": "var(--tracking-normal)",
        "font-variant-numeric": "tabular-nums"
      },
      "::selection": {
        "background-color": "color-mix(in oklab, var(--primary) 35%, transparent)",
        "color": "var(--foreground)"
      }
    }
  },
  "type": "registry:style"
}